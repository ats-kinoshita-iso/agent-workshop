{
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash(git commit*)",
      "type": "command",
      "command": "uv run ruff format --check . && uv run ruff check . && uv run mypy . && uv run pytest -x -q"
    },
    {
      "event": "Stop",
      "type": "command",
      "command": "uv run python plugins/code-quality-gate/hooks/quality_summary.py"
    }
  ]
}
